          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quer abrir um link numa nova separador. Abrir aqui?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vrea să deschidă un link într-un tab nou. Deschidem aici?"
