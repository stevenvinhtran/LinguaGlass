    "%@ wants to open a link in a new tab. Open here?" : {
      "comment" : "An alert that appears when a user tries to open a link in a new tab.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wants to open a link in a new tab. Open here?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quiere abrir un enlace en una nueva pestaña. ¿Abrir aquí?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ veut ouvrir un lien dans un nouvel onglet. L’ouvrir ici ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vuole aprire un link in una nuova scheda. Aprirlo qui?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がリンクを新しいタブで開こうとしています。ここで開きますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@가(이) 새 탭에서 링크를 열려고 합니다. 여기에서 열겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quer abrir um link em uma nova aba. Abrir aqui?"
