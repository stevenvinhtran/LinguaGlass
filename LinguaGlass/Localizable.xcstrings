    "Browse any website normally. Use the search bar to navigate or enter URLs." : {
      "comment" : "Description of a tutorial page focused on web browsing.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse any website normally. Use the search bar to navigate or enter URLs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navega por cualquier sitio web con normalidad. Usa la barra de búsqueda para navegar o introducir URLs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigue normalement sur n’importe quel site. Utilise la barre de recherche pour naviguer ou entrer des URL."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naviga normalmente su qualsiasi sito. Usa la barra di ricerca per spostarti o inserire gli URL."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常通り任意のウェブサイトを閲覧できます。検索バーで移動先を入力するかURLを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹사이트를 일반적으로 탐색하세요. 검색창을 사용해 이동하거나 URL을 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegue por qualquer site normalmente. Use a barra de pesquisa para navegar ou inserir URLs."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navega normalmente por qualquer website. Usa a barra de pesquisa para navegar ou introduzir URLs."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Răsfoiește orice site în mod normal. Folosește bara de căutare pentru a naviga sau pentru a introduce URL-uri."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duyệt bất kỳ trang web nào như bình thường. Dùng thanh tìm kiếm để điều hướng hoặc nhập URL."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像平常一样浏览任何网站。使用搜索栏进行导航或输入网址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像平常一樣瀏覽任何網站。使用搜尋列導航或輸入網址。"
          }
        }
      }
